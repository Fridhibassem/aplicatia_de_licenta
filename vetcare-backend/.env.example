# ────────────────────────────────────────────────
#  VetCare Backend – Environment Variables
#  Copiaza acest fisier ca .env si completeaza valorile
# ────────────────────────────────────────────────

# Server
PORT=3000

# JWT (string lung si random)
JWT_SECRET=schimba_acest_string_cu_unul_lung_si_random_in_productie
JWT_EXPIRES_IN=7d

# CORS – URL-ul frontendului Angular
FRONTEND_URL=http://localhost:4200

# ── MySQL ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vetcare
DB_USER=root
DB_PASS=parola_ta_de_la_mysql
